# Haynoi version metadata — single source of truth for releases.
# Bumped by release.sh on each tag. CI reads these to set:
#   - Info.plist CFBundleShortVersionString = MARKETING_VERSION
#   - Info.plist CFBundleVersion = BUILD_NUMBER
#   - appcast.xml <sparkle:shortVersionString> and <sparkle:version>
#
# Conventions:
#   - MARKETING_VERSION: semver-ish (MAJOR.MINOR.PATCH), user-visible
#   - BUILD_NUMBER: monotonic integer, must increase every release

MARKETING_VERSION=0.1.2
BUILD_NUMBER=3
